      "copyrightYear": "2023+",
      "publisher": {
        "name": "WHO",
        "url": "http://who.int"
      }
    },
    "ig": {
      "_comment": "What this repository is, per the content types its layers register, copied in shape from litlfred/smart-immunizations (bean folio-assistant-cz17). `dak`: smart-base's DAK content type, values from sushi-config.yaml. `ig`: fhir-harness's `ig` content type; `include` lists every input/ entry present when the harness was added (2026-10-31), so nothing is dropped; sushi-config.yaml stays SUSHI's file.",
      "include": [
        "sushi-config.yaml",
        "ig.ini",
        "input/business-processes/",
        "input/cql/",
        "input/data/",
        "input/decision-logic/",
        "input/dictionary/",
        "input/examples/",
        "input/extensions/",
        "input/fsh/",
        "input/history/",
        "input/ignoreWarnings.txt",
        "input/images-source/",
        "input/images/",
        "input/indicators/",
        "input/maps/",
        "input/models/",
        "input/pagecontent/",
        "input/profiles/",
        "input/resources/",
        "input/scenarios/",
        "input/scheduling-logic/",
